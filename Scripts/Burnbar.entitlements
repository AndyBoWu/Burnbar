<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the Developer ID signing path (#167).

  Burnbar is a Developer ID app (NOT Mac App Store), so the App Sandbox is NOT
  enabled — the privacy thesis depends on reading local CLI logs under
  ~/.claude and ~/.codex with full-disk-style file access, which the sandbox
  would block without a user-granted security-scoped bookmark. Hardened runtime
  is still required for notarization; these entitlements only loosen the few
  hardened-runtime restrictions Burnbar actually needs:

    * com.apple.security.network.client  — the M3 leaderboard upload + GitHub
      device-flow auth (outbound HTTPS only; no server entitlement).

  No JIT, no unsigned executable memory, no DYLD env overrides, no library
  validation disable — Sparkle and the embedded BurnbarCore.framework are all
  signed with the SAME Developer ID identity, so the default library-validation
  enforcement (on under hardened runtime) is satisfied.

  This plist is consumed ONLY by Scripts/sign_and_notarize.sh on the Developer
  ID path. The ad-hoc path (CODE_SIGN_IDENTITY "-" in project.yml) does not use
  it and stays unchanged.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
