{
  "name": "burnbar-site",
  "version": "0.1.0",
  "private": true,
  "description": "Burnbar leaderboard web app — Next.js (App Router) + Tailwind, deploys to Cloudflare Pages",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pages:build": "next-on-pages",
    "deploy:staging": "wrangler pages deploy .vercel/output/static --project-name burnbar-site --branch staging",
    "deploy:prod": "wrangler pages deploy .vercel/output/static --project-name burnbar-site --branch main"
  },
  "dependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.7",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "wrangler": "^3.99.0"
  }
}
